# =====================================================================
# SEJA — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA versione valores reais. Segredos apenas via process.env.
# =====================================================================

# --- Ambiente ---
# development | homologacao | production
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (público: exposto ao browser, protegido por RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SERVIDOR: bypassa RLS, jamais expor ao cliente) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# --- Integração SIGAA (autenticação de discentes/servidores) ---
SIGAA_AUTH_URL=
SIGAA_CLIENT_ID=
SIGAA_CLIENT_SECRET=

# --- Sessão / JWT ---
SESSION_SECRET=
SESSION_MAX_AGE=28800

# --- Observabilidade (opcional) ---
SENTRY_DSN=
